{
  "name": "@local/skill-compiler",
  "version": "3.8.2",
  "private": true,
  "type": "module",
  "description": "LifeCode Skill-Compiler: compila el conocimiento reutilizable de una tarea en una skill propuesta, ligada a su proyecto y fuera de todo repositorio.",
  "license": "MIT",
  "author": "designerbyron",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designerbyron/plugins-dhs.git",
    "directory": "skill-compiler"
  },
  "homepage": "https://github.com/designerbyron/plugins-dhs/tree/main/skill-compiler#readme",
  "bugs": {
    "url": "https://github.com/designerbyron/plugins-dhs/issues"
  },
  "icon": "./icon.png",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./compiler": "./lib/compiler.mjs",
    "./presentation": "./lib/presentation.mjs",
    "./cli": "./bin/skill-compiler.mjs"
  },
  "bin": {
    "skill-compiler": "./bin/skill-compiler.mjs"
  },
  "dependencies": {
    "@deepseek-ai/cordis": "4.0.4",
    "@deepseek-ai/cosmokit": "1.8.5",
    "@deepseek-ai/dsh-agent": "0.2.0-rc.2",
    "@deepseek-ai/dsh-brand": "0.2.0-rc.2",
    "@deepseek-ai/dsh-invariants": "0.2.0-rc.2",
    "@deepseek-ai/dsh-llm": "0.2.0-rc.2",
    "@deepseek-ai/dsh-ptc-runtime": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox": "0.2.0-rc.2",
    "@deepseek-ai/dsh-sandbox-policy": "0.2.0-rc.2",
    "@deepseek-ai/dsh-scope": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session": "0.2.0-rc.2",
    "@deepseek-ai/dsh-session-projection": "0.2.0-rc.2",
    "@deepseek-ai/dsh-system-prompt": "0.2.0-rc.2",
    "@deepseek-ai/dsh-timeout": "0.2.0-rc.2",
    "@deepseek-ai/dsh-tools": "0.2.0-rc.2",
    "@deepseek-ai/dsh-typert-protocol": "0.2.0-rc.2",
    "@deepseek-ai/dsh-user-approval": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-crypto": "0.2.0-rc.2",
    "@deepseek-ai/dsh-util-values": "0.2.0-rc.2",
    "zod": "^4.4.3"
  },
  "scripts": {
    "test": "node --test",
    "test:hermetic": "node tests/check-hermetic.mjs"
  },
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-ui-conversation",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "devDependencies": {
    "@deepseek-ai/dsh-skill": "^0.2.0-rc.2"
  }
}

{
  "name": "@local/skill-compiler",
  "version": "1.1.0",
  "private": true,
  "type": "module",
  "description": "LifeCode Skill-Compiler: compila el conocimiento reutilizable de una tarea en una skill propuesta, ligada a su proyecto y fuera de todo repositorio.",
  "license": "MIT",
  "author": "designerbyron",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/designerbyron/plugins-dsh.git",
    "directory": "skill-compiler"
  },
  "homepage": "https://github.com/designerbyron/plugins-dsh/tree/main/skill-compiler#readme",
  "bugs": { "url": "https://github.com/designerbyron/plugins-dsh/issues" },
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./package.json": "./package.json",
    "./locale/*.json": "./locale/*.json",
    "./compiler": "./lib/compiler.mjs",
    "./presentation": "./lib/presentation.mjs",
    "./cli": "./bin/skill-compiler.mjs"
  },
  "bin": { "skill-compiler": "./bin/skill-compiler.mjs" },
  "scripts": {
    "test": "node --test",
    "test:hermetic": "node tests/check-hermetic.mjs"
  },
  "dsh": {
    "bundle": { "patch": "./cordis.patch.yml" },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": ["@deepseek-ai/dsh-client-ui-conversation"]
    }
  }
}

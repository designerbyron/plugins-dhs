          "solo anota en journal.jsonl si el modo de aprobacion automatica esta activo"
        ],
        "restricciones": [
          "id kebab-case ASCII",
          "description de 60 a 300 caracteres",
          "whenToUse de al menos 20 caracteres",
          "body de al menos 200 caracteres con dos secciones ##",
          "references solo bajo references/, sin rutas absolutas ni ..",
          "revision obligatoria cuando el id ya nombra una skill viva",
          "group solo declara lote; no salta la puerta"
        ],
        "seguridad": [
          "la puerta de validacion se aplica siempre, tambien con el modo automatico",
          "ningun parametro puede saltarse la puerta ni aprobar"
